# ==============================================================================
# TRACE — AICTE Application Validation & Regulatory Compliance Engine
# ==============================================================================
# Generate the three secrets below with:  python -m app.cli generate-keys
# Never commit real values.

ENVIRONMENT=production
DATABASE_URL=sqlite:///./aicte_platform.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aicte_db

SECRET_KEY=<generate-with-cli>
AUDIT_HMAC_KEY=<generate-with-cli>
FILE_ENCRYPTION_KEY=<generate-with-cli>

# Comma-separated exact origins (no wildcard)
CORS_ORIGINS=
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ENABLE_API_DOCS=false
MAX_UPLOAD_MB=25

# Local LLM inference via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
